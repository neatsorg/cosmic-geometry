+#[derive(Debug)]
+struct LaunchArgs {
+    app_id: Option<String>,
+    size: (i32, i32),
+    pos: (i32, i32),
+    timeout: u64,
+    follow: u64,
+    reapply: u64,
+    keep_maximized: bool,
+    command: Vec<std::ffi::OsString>,
+}
+
+/// launch で見つけた窓にサイズを当てる。前回の最大化状態を復元して開くアプリ(Firefox など)
+/// のために、最大化されていれば先に解除する(--keep-maximized なら最大化のまま触らない)
+fn apply_launch_geometry(
+    manager: &zcosmic_toplevel_manager_v1::ZcosmicToplevelManagerV1,
+    apps: &[App],
+    handle: &zcosmic_toplevel_handle_v1::ZcosmicToplevelHandleV1,
+    args: &LaunchArgs,
+) {
+    // 一覧にない = すでに閉じた窓なので何もしない
+    let Some(app) = apps.iter().find(|a| &a.handle == handle) else {
+        return;
+    };
+    let maximized = app.state.contains(&State::Maximized);
+    if maximized {
+        if args.keep_maximized {
+            return;
+        }
+        manager.unset_maximized(handle);
+    }
+    manager.set_geometry(handle, args.pos.0, args.pos.1, args.size.0, args.size.1);
+}
+
+/// "1280x800" を (1280, 800) に変換する。"96%" のような割合はプロトコル上の負の値(-96)にする
+fn parse_size(v: &str) -> Result<(i32, i32), String> {
+    fn axis(a: &str, v: &str) -> Result<i32, String> {
+        let a = a.trim();
+        if let Some(p) = a.strip_suffix('%') {
+            match p.trim().parse::<i32>() {
+                Ok(p) if (1..=100).contains(&p) => Ok(-p),
+                _ => Err(format!("Invalid percentage (1-100%): {v}")),
+            }
+        } else {
+            match a.parse::<i32>() {
+                Ok(n) if n > 0 => Ok(n),
+                _ => Err(format!(
+                    "Invalid size (expected WxH, e.g. 1280x800 or 96%x92%): {v}"
+                )),
+            }
+        }
+    }
+    let (w, h) = v
+        .split_once(['x', 'X'])
+        .ok_or_else(|| format!("Invalid size (expected WxH): {v}"))?;
+    Ok((axis(w, v)?, axis(h, v)?))
+}
+
+/// プロトコル上の特別な位置の値
+const POS_KEEP: i32 = -1; // 現在の中心を保つ
+const POS_CENTER: i32 = -2; // 利用可能領域の中央
+
+/// 位置指定を解析する。"100,50" / "center" / "keep" / "center,0" のように軸ごとにも書ける
+fn parse_pos(v: &str) -> Result<(i32, i32), String> {
+    fn axis(a: &str, v: &str) -> Result<i32, String> {
+        match a.trim() {
+            "center" | "c" => Ok(POS_CENTER),
+            "keep" | "k" => Ok(POS_KEEP),
+            n => match n.parse::<i32>() {
+                Ok(n) if n >= 0 => Ok(n),
+                _ => Err(format!(
+                    "Invalid position (use X,Y with X,Y >= 0, 'center' or 'keep'): {v}"
+                )),
+            },
+        }
+    }
+    match v.split_once(',') {
+        Some((x, y)) => Ok((axis(x, v)?, axis(y, v)?)),
+        None => {
+            let a = axis(v, v)?;
+            if a >= 0 {
+                return Err(format!("Invalid position (expected X,Y): {v}"));
+            }
+            Ok((a, a))
+        }
+    }
+}
+
+/// manager が set_geometry(v5)に対応しているか確認して返す
+fn geometry_manager(
+    state: &AppState,
+) -> Result<&zcosmic_toplevel_manager_v1::ZcosmicToplevelManagerV1, Box<dyn Error>> {
+    let Some(manager) = &state.cosmic_toplevel_manager else {
+        return Err(CliError::new(
+            "Compositor does not support toplevel management protocol.".into(),
+        ));
+    };
+    if state.manager_version < 5 {
+        return Err(CliError::new(format!(
+            "Compositor's toplevel manager is version {}, set_geometry needs version 5 (patched cosmic-comp).",
+            state.manager_version
+        )));
+    }
+    Ok(manager)
+}
