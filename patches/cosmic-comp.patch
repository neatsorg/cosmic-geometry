+    /// 外部(toplevel-management の set_geometry)からのサイズ・位置変更。
+    /// `position` は出力の利用可能領域(パネル等を除く)からの相対座標。軸ごとに
+    /// Keep なら現在の中心を保ってサイズを変え、Center なら利用可能領域の中央に置く。
+    /// 最大化中・全画面中は何もしない。
+    pub fn set_window_geometry(
+        &mut self,
+        mapped: &CosmicMapped,
+        position: (GeometryAxis, GeometryAxis),
+        size: Size<i32, Logical>,
+    ) -> bool {
+        if mapped.is_maximized(true) || mapped.is_fullscreen(true) {
+            return false;
+        }
+        let Some(current) = self.space.element_geometry(mapped).map(RectExt::as_local) else {
+            return false; // このレイヤーにないウィンドウ
+        };
+
+        let output = self.space.outputs().next().unwrap().clone();
+        let zone = layer_map_for_output(&output)
+            .non_exclusive_zone()
+            .as_local();
+
+        // 最小・最大サイズと利用可能領域に収める
+        let (min_size, max_size) = (mapped.min_size(), mapped.max_size());
+        let min_w = min_size.map(|s| s.w).filter(|w| *w > 0).unwrap_or(1);
+        let min_h = min_size.map(|s| s.h).filter(|h| *h > 0).unwrap_or(1);
+        let max_w = max_size.map(|s| s.w).filter(|w| *w > 0).unwrap_or(i32::MAX);
+        let max_h = max_size.map(|s| s.h).filter(|h| *h > 0).unwrap_or(i32::MAX);
+        // 負の値 -N は利用可能領域の N%(1〜100)
+        let percent = |v: i32, total: i32| {
+            if v < 0 {
+                (total as i64 * (v.unsigned_abs().min(100) as i64) / 100) as i32
+            } else {
+                v
+            }
+        };
+        let req_w = percent(size.w, zone.size.w);
+        let req_h = percent(size.h, zone.size.h);
+        let w = req_w.clamp(min_w, max_w.max(min_w)).min(zone.size.w);
+        let h = req_h.clamp(min_h, max_h.max(min_h)).min(zone.size.h);
+
+        // 中心の基準にするサイズ。表示直後はアプリの描画(committed)がまだ古いサイズのことがあるので、
+        // コンポジタが最後に指示したサイズ(pending)を優先する
+        let base_size = mapped
+            .pending_size()
+            .filter(|s| s.w > 0 && s.h > 0)
+            .map(SizeExt::as_local)
+            .unwrap_or(current.size);
+
+        // 位置: 指定があれば利用可能領域基準、なければ現在の中心を保つ。はみ出さないよう寄せる
+        let mut x = match position.0 {
+            GeometryAxis::At(x) => zone.loc.x.saturating_add(x),
+            GeometryAxis::Keep => current.loc.x + (base_size.w - w) / 2,
+            GeometryAxis::Center => zone.loc.x + (zone.size.w - w) / 2,
+        };
+        let mut y = match position.1 {
+            GeometryAxis::At(y) => zone.loc.y.saturating_add(y),
+            GeometryAxis::Keep => current.loc.y + (base_size.h - h) / 2,
+            GeometryAxis::Center => zone.loc.y + (zone.size.h - h) / 2,
+        };
+        x = x.min(zone.loc.x + zone.size.w - w).max(zone.loc.x);
+        y = y.min(zone.loc.y + zone.size.h - h).max(zone.loc.y);
+
+        let geometry = Rectangle::<i32, Local>::new((x, y).into(), (w, h).into());
+
+        // 隅へのスナップ状態は解除する
+        if mapped.floating_tiled.lock().unwrap().take().is_some() {
+            mapped.set_tiled(false);
+        }
+        mapped.moved_since_mapped.store(true, Ordering::SeqCst);
+        mapped.set_geometry(geometry.to_global(&output));
+        mapped.configure();
+
+        self.animations.insert(
+            mapped.clone(),
+            Animation::Tiled {
+                start: Instant::now(),
+                previous_geometry: current,
+            },
+        );
+        self.space
+            .map_element(mapped.clone(), geometry.loc.as_logical(), false);
+        self.space.refresh();
+        true
+    }
