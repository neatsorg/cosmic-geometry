+
+/// set_geometry の位置指定(軸ごと)
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum GeometryAxis {
+    /// 利用可能領域からの相対座標
+    At(i32),
+    /// 現在の中心を保つ
+    Keep,
+    /// 利用可能領域の中央
+    Center,
+}
+
+impl GeometryAxis {
+    /// プロトコルの値から変換する(0 以上 = 座標、-1 = Keep、-2 以下 = Center)
+    pub fn from_protocol(v: i32) -> Self {
+        match v {
+            v if v >= 0 => GeometryAxis::At(v),
+            -1 => GeometryAxis::Keep,
+            _ => GeometryAxis::Center,
+        }
+    }
+}
