+        x: i32,
+        y: i32,
+        width: i32,
+        height: i32,
+    ) {
+        let mut shell = self.common.shell.write();
+        let Some(mapped) = shell.element_for_surface(window).cloned() else {
+            return;
+        };
+        let position = (
+            crate::shell::layout::floating::GeometryAxis::from_protocol(x),
+            crate::shell::layout::floating::GeometryAxis::from_protocol(y),
+        );
+        let size = Size::from((width, height));
+
+        // 通常のワークスペースのフローティングレイヤー(タイル中のウィンドウは対象外)
+        if let Some(workspace) = shell.space_for_mut(&mapped) {
+            if workspace.is_floating(window) {
+                workspace
+                    .floating_layer
+                    .set_window_geometry(&mapped, position, size);
+            }
+            return;
+        }
+        // 全ワークスペース表示(sticky)のウィンドウ
+        for set in shell.workspaces.sets.values_mut() {
+            if set.sticky_layer.mapped().any(|m| m == &mapped) {
+                set.sticky_layer
+                    .set_window_geometry(&mapped, position, size);
+                return;
+            }
+        }
+    }
