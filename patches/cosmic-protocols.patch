+    <request name="set_geometry" since="5">
+      <description summary="request a new size and position for a floating toplevel">
+        Request that a floating toplevel be resized to the given size and
+        optionally moved. The size is the outer size of the window as managed
+        by the compositor (including server-side decorations, if any).
+
+        x and y are relative to the usable area (excluding panels and other
+        exclusive zones) of the output the toplevel is currently on. For each
+        axis, -1 resizes the toplevel around its current center, and -2 (or any
+        smaller value) centers it in the usable area. The result is moved as
+        needed to stay inside the usable area.
+
+        The compositor may clamp the size to the toplevel's min/max size and to
+        the usable area, and is free to ignore the request (e.g. for tiled,
+        maximized or fullscreen toplevels).
+      </description>
+      <arg name="toplevel" type="object" interface="zcosmic_toplevel_handle_v1"/>
+      <arg name="x" type="int"/>
+      <arg name="y" type="int"/>
+      <arg name="width" type="int"/>
+      <arg name="height" type="int"/>
+    </request>
+
     <enum name="error">
